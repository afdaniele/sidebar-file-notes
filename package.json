{
  "name": "sidebar-file-notes",
  "displayName": "Sidebar File Notes",
  "description": "Markdown notes in the sidebar that follow the active file or Claude Code conversation",
  "version": "2.0.0",
  "publisher": "afdaniele",
  "author": {
    "name": "Andrea F. Daniele",
    "url": "https://github.com/afdaniele"
  },
  "contributors": [
    {
      "name": "Matheus Assis Rios",
      "url": "https://github.com/AssisrMatheus"
    }
  ],
  "license": "GPL-3.0-or-later",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/afdaniele/sidebar-file-notes"
  },
  "keywords": [
    "markdown",
    "notes",
    "sidebar",
    "per-file",
    "claude",
    "claude-code",
    "todo",
    "checklist"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "sidebarFileNotes.view",
          "name": "Notes"
        }
      ]
    },
    "commands": [
      {
        "command": "sidebarFileNotes.togglePreview",
        "category": "Sidebar File Notes",
        "title": "Toggle Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "sidebarFileNotes.lock",
        "category": "Sidebar File Notes",
        "title": "Lock to Current Note",
        "icon": "$(unlock)"
      },
      {
        "command": "sidebarFileNotes.unlock",
        "category": "Sidebar File Notes",
        "title": "Unlock (Follow Active Editor)",
        "icon": "$(lock)"
      },
      {
        "command": "sidebarFileNotes.openNoteFile",
        "category": "Sidebar File Notes",
        "title": "Open Note File in Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sidebarFileNotes.deleteNote",
        "category": "Sidebar File Notes",
        "title": "Delete Current Note",
        "icon": "$(trash)"
      },
      {
        "command": "sidebarFileNotes.revealNotesFolder",
        "category": "Sidebar File Notes",
        "title": "Reveal Notes Folder"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sidebarFileNotes.togglePreview",
          "group": "navigation@0",
          "when": "view == sidebarFileNotes.view"
        },
        {
          "command": "sidebarFileNotes.lock",
          "group": "navigation@1",
          "when": "view == sidebarFileNotes.view && !sidebarFileNotes.locked"
        },
        {
          "command": "sidebarFileNotes.unlock",
          "group": "navigation@1",
          "when": "view == sidebarFileNotes.view && sidebarFileNotes.locked"
        },
        {
          "command": "sidebarFileNotes.openNoteFile",
          "group": "navigation@2",
          "when": "view == sidebarFileNotes.view"
        },
        {
          "command": "sidebarFileNotes.deleteNote",
          "group": "more@0",
          "when": "view == sidebarFileNotes.view"
        },
        {
          "command": "sidebarFileNotes.revealNotesFolder",
          "group": "more@1",
          "when": "view == sidebarFileNotes.view"
        }
      ]
    },
    "configuration": [
      {
        "title": "Sidebar File Notes",
        "properties": {
          "sidebarFileNotes.notesDirectory": {
            "type": "string",
            "default": ".notes",
            "markdownDescription": "Where note files are stored. A relative path is resolved against each workspace folder. An absolute path (or one starting with `~`) holds the notes of every workspace, in one subfolder per workspace folder."
          },
          "sidebarFileNotes.claudeCode.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Give each Claude Code conversation tab its own note."
          },
          "sidebarFileNotes.claudeCode.configDir": {
            "type": "string",
            "default": "",
            "markdownDescription": "Claude Code's config directory, where the session transcripts used to identify conversations are stored. Empty means `$CLAUDE_CONFIG_DIR`, or `~/.claude` when that is unset."
          },
          "sidebarFileNotes.leftMargin": {
            "type": "boolean",
            "default": false,
            "description": "Add a left margin to the notes view, to align it with other sidebar content."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --mode production --devtool hidden-source-map",
    "build": "webpack",
    "watch": "webpack --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint src --ext ts",
    "test": "tsc -p ./ && mocha 'out/test/**/*.test.js'",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.75.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vscode/vsce": "^3.2.1",
    "dompurify": "^3.1.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "marked": "12.0.2",
    "mocha": "^10.4.0",
    "prettier": "^3.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
